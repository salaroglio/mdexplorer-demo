{
  "mde_workflow": 3,
  "title": "Gara: dal bando alla decisione",
  "description": "Dal bando trovato sul portale alla decisione dell'account manager se partecipare.",
  "variables": {
    "codice": "il codice del bando su cui si fa il giro, scelto con «Avvia il giro»",
    "capitolato": "il documento di gara che l'account manager ha scaricato dal portale per quel bando",
    "ricerca": "la ricerca dell'account manager, con la domanda che lascia a ciascun responsabile"
  },
  "steps": [
    {
      "id": "ricerca",
      "agent": "account-manager",
      "skill": "cerca-bandi",
      "title": "Cerca i bandi",
      "trigger": {
        "launch": true
      },
      "start": "manual"
    },
    {
      "id": "tecnica",
      "agent": "responsabile-tecnico",
      "skill": "scheda-tecnica",
      "title": "Scheda tecnica",
      "trigger": {
        "reply": "avvia-giro",
        "to": "ricerca"
      },
      "start": "ask-owner",
      "inputs": {
        "codice": "{codice}",
        "capitolato": "{capitolato}",
        "ricerca": "{ricerca}",
        "criterio": "2 — competenza"
      }
    },
    {
      "id": "contratto",
      "agent": "responsabile-legale",
      "skill": "scheda-contrattuale",
      "title": "Scheda contrattuale",
      "trigger": {
        "reply": "avvia-giro",
        "to": "ricerca"
      },
      "start": "ask-owner",
      "inputs": {
        "codice": "{codice}",
        "capitolato": "{capitolato}",
        "ricerca": "{ricerca}",
        "criterio": "4 — rischio contrattuale"
      }
    },
    {
      "id": "delivery",
      "agent": "responsabile-delivery",
      "skill": "scheda-delivery",
      "title": "Scheda di delivery",
      "trigger": {
        "reply": "avvia-giro",
        "to": "ricerca"
      },
      "start": "ask-owner",
      "inputs": {
        "codice": "{codice}",
        "capitolato": "{capitolato}",
        "ricerca": "{ricerca}",
        "criterio": "3 — tempi di consegna"
      }
    },
    {
      "id": "sintesi",
      "agent": "account-manager",
      "skill": "sintesi-gara",
      "title": "Sintesi per decidere",
      "trigger": {
        "after": [
          "tecnica",
          "contratto",
          "delivery"
        ],
        "wait": "all"
      },
      "start": "auto",
      "inputs": {
        "codice": "{codice}",
        "ricerca": "{ricerca}",
        "schede": {
          "from": [
            "tecnica.scheda",
            "contratto.scheda",
            "delivery.scheda"
          ]
        }
      }
    },
    {
      "id": "decisione",
      "person": "Account manager",
      "title": "Decidi se partecipare",
      "trigger": {
        "after": [
          "sintesi"
        ]
      },
      "task": "Leggi la sintesi sul bando {codice} e decidi se Pentagroup partecipa.",
      "inputs": {
        "sintesi": {
          "from": "sintesi.sintesi"
        }
      },
      "outcomes": [
        {
          "id": "partecipa",
          "label": "Partecipiamo"
        },
        {
          "id": "rinuncia",
          "label": "Non partecipiamo"
        }
      ]
    }
  ],
  "loops": [
    {
      "id": "rifacimento",
      "steps": [
        "tecnica",
        "contratto",
        "delivery"
      ],
      "until": "approved",
      "restart": "manual"
    }
  ]
}
