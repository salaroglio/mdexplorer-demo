{
  "mde_workflow": 3,
  "title": "Tender: from the call for tenders to the decision",
  "description": "From the call for tenders found on the portal to the account manager's decision whether to bid.",
  "variables": {
    "code": "the code of the call for tenders the round is on, chosen with «Start the round»",
    "specification": "the tender document the account manager downloaded from the portal for that call for tenders",
    "search": "the account manager's search, with the question it leaves to each lead"
  },
  "steps": [
    {
      "id": "search",
      "agent": "account-manager",
      "skill": "find-tenders",
      "title": "Find the calls for tenders",
      "trigger": {
        "launch": true
      },
      "start": "manual"
    },
    {
      "id": "technical",
      "agent": "technical-lead",
      "skill": "technical-sheet",
      "title": "Technical sheet",
      "trigger": {
        "reply": "start-round",
        "to": "search"
      },
      "start": "ask-owner",
      "inputs": {
        "code": "{code}",
        "specification": "{specification}",
        "search": "{search}",
        "criterion": "2 — competence"
      }
    },
    {
      "id": "contract",
      "agent": "legal-lead",
      "skill": "contract-sheet",
      "title": "Contract sheet",
      "trigger": {
        "reply": "start-round",
        "to": "search"
      },
      "start": "ask-owner",
      "inputs": {
        "code": "{code}",
        "specification": "{specification}",
        "search": "{search}",
        "criterion": "4 — contract risk"
      }
    },
    {
      "id": "delivery",
      "agent": "delivery-lead",
      "skill": "delivery-sheet",
      "title": "Delivery sheet",
      "trigger": {
        "reply": "start-round",
        "to": "search"
      },
      "start": "ask-owner",
      "inputs": {
        "code": "{code}",
        "specification": "{specification}",
        "search": "{search}",
        "criterion": "3 — delivery timing"
      }
    },
    {
      "id": "synthesis",
      "agent": "account-manager",
      "skill": "tender-synthesis",
      "title": "Synthesis for the decision",
      "trigger": {
        "after": [
          "technical",
          "contract",
          "delivery"
        ],
        "wait": "all"
      },
      "start": "auto",
      "inputs": {
        "code": "{code}",
        "search": "{search}",
        "sheets": {
          "from": [
            "technical.sheet",
            "contract.sheet",
            "delivery.sheet"
          ]
        }
      }
    },
    {
      "id": "decision",
      "person": "Account manager",
      "title": "Decide whether to bid",
      "trigger": {
        "after": [
          "synthesis"
        ]
      },
      "task": "Read the synthesis on the call for tenders {code} and decide whether Pentagroup bids.",
      "inputs": {
        "synthesis": {
          "from": "synthesis.synthesis"
        }
      },
      "outcomes": [
        {
          "id": "bid",
          "label": "We bid"
        },
        {
          "id": "pass",
          "label": "We do not bid"
        }
      ]
    }
  ],
  "loops": [
    {
      "id": "rework",
      "steps": [
        "technical",
        "contract",
        "delivery"
      ],
      "until": "approved",
      "restart": "manual"
    }
  ]
}
